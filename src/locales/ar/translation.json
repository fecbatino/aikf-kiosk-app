  "dark_mode": "\u0627\u0644\u0645\u0638\u0647\u0631 \u0627\u0644\u062f\u0627\u0643\u0646",
  "select_language": "\u0627\u062e\u062a\u0631 \u0627\u0644\u0644\u063a\u0629",
  "footer_links": "\u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0648\u0627\u0644\u0625\u062f\u0627\u0631\u0629",
  "loading": "\u062c\u0627\u0631\u064d \u0627\u0644\u062a\u062d\u0645\u064a\u0644\u2026",
  "payment_processing": "\u062a\u0645 \u0642\u0628\u0648\u0644 \u0637\u0644\u0628 \u0627\u0644\u062f\u0641\u0639 \u0648\u0647\u0648 \u0642\u064a\u062f \u0627\u0644\u0645\u0639\u0627\u0644\u062c\u0629. \u0644\u0645 \u064a\u064f\u0624\u0643\u0651\u062f \u0627\u0644\u0627\u0633\u062a\u0644\u0627\u0645 \u0628\u0639\u062f. \u064a\u0631\u062c\u0649 \u0639\u062f\u0645 \u0627\u0644\u062f\u0641\u0639 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649.",
  "transfer_record_error": "\u062a\u0639\u0630\u0631 \u062a\u0633\u062c\u064a\u0644 \u0646\u064a\u0629 \u0627\u0644\u062a\u0628\u0631\u0639. \u0625\u0630\u0627 \u0643\u0646\u062a \u0642\u062f \u062d\u0648\u0651\u0644\u062a \u0627\u0644\u0645\u0628\u0644\u063a\u060c \u064a\u0631\u062c\u0649 \u0639\u062f\u0645 \u0627\u0644\u062f\u0641\u0639 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649. \u064a\u0645\u0643\u0646\u0643 \u0625\u0639\u0627\u062f\u0629 \u0645\u062d\u0627\u0648\u0644\u0629 \u0627\u0644\u062d\u0641\u0638.",
