  "transfer_no_confirmation": "\u064a\u0645\u0644\u0623 \u0627\u0644\u0631\u0645\u0632 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u062a\u062d\u0648\u064a\u0644. \u0623\u0643\u0651\u062f \u0627\u0644\u0639\u0645\u0644\u064a\u0629 \u0641\u064a \u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0628\u0646\u0643.",
  "transfer_record": "\u062a\u0633\u062c\u064a\u0644 \u0646\u064a\u0629 \u0627\u0644\u062a\u0628\u0631\u0639",
  "transfer_pending": "\u0633\u064f\u062c\u0651\u0644\u062a \u0646\u064a\u0629 \u0627\u0644\u062a\u0628\u0631\u0639. \u0644\u0645 \u064a\u064f\u0624\u0643\u0651\u062f \u0648\u0635\u0648\u0644 \u0627\u0644\u0645\u0628\u0644\u063a \u0628\u0639\u062f. \u064a\u0631\u062c\u0649 \u062a\u0623\u0643\u064a\u062f \u0627\u0644\u062a\u062d\u0648\u064a\u0644 \u0641\u064a \u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0628\u0646\u0643.",
  "prepare_checkout": "\u0625\u0639\u062f\u0627\u062f \u0627\u0644\u062f\u0641\u0639 \u0627\u0644\u0622\u0645\u0646",
  "start_terminal": "\u0628\u062f\u0621 \u0627\u0644\u062f\u0641\u0639 \u0628\u0627\u0644\u0628\u0637\u0627\u0642\u0629",
  "scan_phone": "\u0627\u0645\u0633\u062d \u0627\u0644\u0631\u0645\u0632 \u0628\u0647\u0627\u062a\u0641\u0643",
  "present_card": "\u0642\u0631\u0651\u0628 \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0645\u0646 \u062c\u0647\u0627\u0632 \u0627\u0644\u062f\u0641\u0639 \u0623\u0648 \u0623\u062f\u062e\u0644\u0647\u0627",
  "open_checkout": "\u0627\u0644\u062f\u0641\u0639 \u0639\u0644\u0649 \u0647\u0630\u0627 \u0627\u0644\u062c\u0647\u0627\u0632",
  "awaiting_payment": "\u0628\u0627\u0646\u062a\u0638\u0627\u0631 \u062a\u0623\u0643\u064a\u062f \u0627\u0644\u062f\u0641\u0639\u2026",
  "payment_not_completed": "\u0623\u064f\u0644\u063a\u064a \u0627\u0644\u062f\u0641\u0639 \u0623\u0648 \u062a\u0639\u0630\u0631. \u0644\u0645 \u064a\u0635\u0644 \u062a\u0623\u0643\u064a\u062f.",
  "payment_safety_note": "\u064a\u064f\u0639\u062f \u0627\u0644\u0645\u0628\u0644\u063a \u0645\u0633\u062a\u0644\u0645\u064b\u0627 \u0628\u0639\u062f \u062a\u0623\u0643\u064a\u062f \u0645\u0632\u0648\u062f \u0627\u0644\u062f\u0641\u0639 \u0641\u0642\u0637.",
  "cancel_payment": "\u0625\u0644\u063a\u0627\u0621 \u0627\u0644\u062f\u0641\u0639 \u0648\u0627\u0644\u0639\u0648\u062f\u0629",
  "payment_confirmed": "\u062a\u0645 \u062a\u0623\u0643\u064a\u062f \u0627\u0644\u062f\u0641\u0639. \u0634\u0643\u0631\u064b\u0627 \u0644\u062f\u0639\u0645\u0643\u0645!",
