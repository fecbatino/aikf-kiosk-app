  "payment_error": "\u062a\u0639\u0630\u0631 \u0625\u0639\u062f\u0627\u062f \u0627\u0644\u062f\u0641\u0639. \u062d\u0627\u0648\u0644 \u0645\u062c\u062f\u062f\u064b\u0627 \u0623\u0648 \u0627\u062e\u062a\u0631 \u0627\u0644\u062a\u062d\u0648\u064a\u0644 \u0627\u0644\u0628\u0646\u0643\u064a.",
  "payment_cancel_error": "\u062d\u0627\u0644\u0629 \u0627\u0644\u062f\u0641\u0639 \u063a\u064a\u0631 \u0648\u0627\u0636\u062d\u0629. \u0627\u0646\u062a\u0638\u0631 \u0648\u062a\u062d\u0642\u0642 \u0645\u062c\u062f\u062f\u064b\u0627 \u0642\u0628\u0644 \u0628\u062f\u0621 \u062f\u0641\u0639 \u0622\u062e\u0631.",
  "status_unavailable": "\u062a\u0639\u0630\u0631 \u062c\u0644\u0628 \u0627\u0644\u062a\u0623\u0643\u064a\u062f. \u0631\u0628\u0645\u0627 \u0646\u062c\u062d \u0627\u0644\u062f\u0641\u0639. \u064a\u0631\u062c\u0649 \u0639\u062f\u0645 \u0627\u0644\u062f\u0641\u0639 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649.",
  "config_unavailable": "\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u062f\u0641\u0639 \u063a\u064a\u0631 \u0645\u062a\u0627\u062d\u0629. \u0644\u0627 \u064a\u0632\u0627\u0644 \u0627\u0644\u062a\u062d\u0648\u064a\u0644 \u0627\u0644\u0628\u0646\u0643\u064a \u0645\u062a\u0627\u062d\u064b\u0627.",
  "test_mode": "\u0648\u0636\u0639 \u0627\u0644\u0627\u062e\u062a\u0628\u0627\u0631: \u0644\u0627 \u062a\u064f\u062d\u0635\u0651\u0644 \u0645\u062f\u0641\u0648\u0639\u0627\u062a \u062d\u0642\u064a\u0642\u064a\u0629.",
  "idle_warning": "\u0633\u062a\u0646\u062a\u0647\u064a \u0627\u0644\u062c\u0644\u0633\u0629 \u062e\u0644\u0627\u0644 {{count}} \u062b\u0627\u0646\u064a\u0629 \u0644\u062d\u0645\u0627\u064a\u0629 \u0628\u064a\u0627\u0646\u0627\u062a\u0643.",
  "continue_session": "\u0645\u062a\u0627\u0628\u0639\u0629",
  "skip_content": "\u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u062a\u0648\u0649",
